# Docker Compose starts without this file. Copy to .env only to override defaults.
# External port for Docker; the application always uses port 3001 inside the container.
APP_PORT=3001

# Local npm startup settings (Compose overrides these inside the container).
# Node.js 24 reads .env through --env-file-if-exists=.env in npm scripts.
PORT=3001
HOST=0.0.0.0
DATA_DIR=./data
# Set NODE_ENV=production on the deployment server. Do not set development for Vite builds.

# Comma-separated exact browser origins. Add your local network / HTTPS URL.
# With a different API PORT, update the development proxy in vite.config.ts.
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001
# Set true when served through HTTPS. Keep false for local HTTP development.
COOKIE_SECURE=false

# Web Push keys are generated on first start and persisted in DATA_DIR.
# Use a contact address belonging to your deployment before public hosting.
VAPID_SUBJECT=mailto:admin@example.invalid

# Optional Chat Completions compatible model. Empty values use local demo rules.
# Local npm endpoint: http://127.0.0.1:11434/v1
# Docker endpoint for a model running on the host: http://host.docker.internal:11434/v1
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5-mini
AI_API_KEY=your_api_key


# OpenAI example: AI_BASE_URL=https://api.openai.com/v1 and AI_MODEL=gpt-5-mini
# GPT-5/mini/nano use minimal reasoning and max_completion_tokens (no temperature).
# Shared daily call cap (UTC), persistent across container restarts; failures count too.
AI_DAILY_REQUEST_LIMIT=150
# Assistant calls per authenticated user in a rolling hour.
AI_USER_HOURLY_LIMIT=20
# Output token caps include hidden reasoning tokens for GPT-5.
AI_ASSISTANT_MAX_TOKENS=1200
AI_REVIEW_MAX_TOKENS=3000
# At most two simultaneous model calls. These are usage caps, not a dollar budget.

# Explicit opt-in to sending before/after images to the configured model.
# Keep false for external services until photos have been reviewed for personal data.
AI_SEND_PHOTOS=true
