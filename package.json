{
  "name": "naryad-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --env-file-if-exists=.env --watch server/index.mjs\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "test:e2e": "playwright test",
    "record:demo": "node scripts/record-demo.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "concurrently": { "shell-quote": "^1.12.0" },
    "exceljs": { "uuid": "^11.1.1" }
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.1.0",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  }
}
